{
  "name": "dfs-sss-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed File System with Shamir's Secret Sharing (DFS_SSS)",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "dev": "pnpm --parallel --filter ./apps/* run dev",
    "dev:coordinator": "pnpm --filter coordinator run dev",
    "dev:storage-node": "pnpm --filter storage-node run dev",
    "dev:frontend": "pnpm --filter frontend run dev",
    "docker:up": "docker-compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infrastructure/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
