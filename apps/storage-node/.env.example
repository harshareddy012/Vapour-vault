# Storage Node Configuration
# ──────────────────────────────────────────────────────────────────────────────
# PORT: the port this node listens on (5001–5005 for the 5-node local cluster)
PORT=5001

# NODE_NAME: human-readable identifier; used in logs and health-check responses
NODE_NAME=node-1

# STORAGE_DIR: root directory where chunks are written
# Layout on disk:  <STORAGE_DIR>/<fileId>/<chunkId>.bin
STORAGE_DIR=./storage

# LOG_LEVEL: pino log level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# NODE_ENV: controls pino-pretty transport in development
NODE_ENV=development
